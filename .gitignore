# 本仓库 scripts 零依赖，只用运行环境内置模块。
# 下面是各生态常见的依赖与产物目录，为协作者本地环境兜底，不代表本仓库需要它们。

node_modules/
.pnpm-store/
.yarn/
bower_components/

# Python（scripts 目前全是 Node，但保留以免将来混入）
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 编辑器与操作系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# 临时与产物
*.log
*.tmp
*.bak
*.tgz
coverage/
.cache/

# 构建产物（Node / 通用）
dist/
build/
out/

# 构建产物（Rust / Java）
target/

# 依赖兜底（Go / PHP 等 vendored 依赖）
vendor/

# 前端框架产物（Next.js / Nuxt）
.next/
.nuxt/

# 构建缓存（Gradle / Turborepo）
.gradle/
.turbo/

# 本地工具状态：多智能体协作的团队清单与邮箱，只属于本机，不进版本库。
# 用 **/ 而非仅根目录：工具可能在子目录里被唤起，何处生成都同样兜住。
**/.agent-teams/
